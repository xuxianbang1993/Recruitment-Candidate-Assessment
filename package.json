{
	"name": "recruitment-assessment",
	"private": true,
	"version": "1.5.0",
	"type": "module",
	"main": "electron/main.js",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"electron:dev": "cross-env NODE_ENV=development electron electron/main.js",
		"electron:build": "npm run build && npm run electron:rebuild && electron-builder --win",
		"electron:rebuild": "electron-rebuild -f -w better-sqlite3"
	},
	"overrides": {
		"cookie": ">=0.7.0"
	},
	"devDependencies": {
		"@electron/rebuild": "^4.0.3",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.1",
		"@types/better-sqlite3": "^7.6.13",
		"cross-env": "^10.1.0",
		"electron": "^41.0.2",
		"electron-builder": "^26.8.1",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.79.0",
		"@fontsource/noto-sans-sc": "^5.2.9",
		"@fontsource/playfair-display": "^5.2.8",
		"@napi-rs/canvas": "^0.1.97",
		"@types/dompurify": "^3.0.5",
		"better-sqlite3": "^12.8.0",
		"chart.js": "^4.5.1",
		"docx": "^9.6.1",
		"dompurify": "^3.3.3",
		"mammoth": "^1.12.0",
		"marked": "^17.0.4",
		"multilingual-purejs-ocr": "^1.0.1",
		"openai": "^6.31.0",
		"unpdf": "^1.4.0"
	}
}
