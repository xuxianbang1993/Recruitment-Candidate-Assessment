{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Write",
      "Edit",
      "WebSearch",
      "WebFetch",
      "mcp__plugin_claude-mem_mcp-search__smart_outline",
      "mcp__fetch__fetch"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf C:*)"
    ]
  }
}
